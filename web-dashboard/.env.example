# URL API untuk fetch sisi server Next.js (Route Handlers). Tidak dikirim ke browser.
API_BASE_URL=http://localhost:8080/api/v1

# URL API yang dapat diakses browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Opsional: paksa cookie sesi Secure (true/false). Default: true di production.
# COOKIE_SECURE=false
