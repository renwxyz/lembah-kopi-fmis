# Lembah Kopi FMIS - Backend Core System Environment Variables
# Copy file ini menjadi .env jika menjalankan secara manual / bare-metal:
#   cp .env.example .env

# Koneksi Database PostgreSQL dengan PostGIS
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/lembah_kopi_db?sslmode=disable

# Secret key untuk penandatanganan token JWT (Wajib minimal 32 karakter)
JWT_SECRET=lembah-kopi-secret-key-development-minimum-32-chars-long

# Host dan Port HTTP server internal
HTTP_ADDRESS=:8080

# Daftar origin frontend yang diizinkan untuk CORS (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MinIO (penyimpanan foto CMS). Kosongkan MINIO_ENDPOINT untuk menonaktifkan unggah foto.
# Jalankan lewat: make minio
# Kompresi WebP butuh biner `cwebp` di host (Debian/Ubuntu: sudo apt install webp).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=lembahkopi
MINIO_SECRET_KEY=lembahkopi-minio-dev-secret
MINIO_BUCKET=lembah-kopi
MINIO_USE_SSL=false
# URL yang dibuka browser untuk menampilkan foto
MINIO_PUBLIC_URL=http://localhost:9000
