# ==============================================================================
# LEMBAH KOPI FMIS & COMMUNITY PROFILE - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Gunakan file ini sebagai acuan saat melakukan setup environment di server production.
# JANGAN PERNAH menyalin nilai default/development rahasia ke lingkungan production!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE POSTGRESQL + POSTGIS (core-system)
# ------------------------------------------------------------------------------
# Ganti user, password acak kuat (min. 24 karakter), host private/managed DB, dan nama DB.
# Contoh: postgres://lembahkopi_app:StrongRandomPassw0rd!@10.0.0.5:5432/lembah_kopi_prod?sslmode=require
DATABASE_URL=postgres://app_user:CHANGE_ME_STRONG_PASSWORD@postgres_host:5432/lembah_kopi_prod?sslmode=require

# ------------------------------------------------------------------------------
# 2. KEAMANAN & AUTENTIKASI JWT (core-system)
# ------------------------------------------------------------------------------
# Generate string acak minimal 64 karakter (misal: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARACTERS_HEX_OR_RANDOM_SECRET_KEY_FOR_PROD

# Alamat listen server API (default :8080 di balik reverse proxy)
HTTP_ADDRESS=:8080

# ------------------------------------------------------------------------------
# 3. DOMAIN & CORS ALLOWLIST (core-system)
# ------------------------------------------------------------------------------
# Daftarkan FQDN domain publik dashboard dan compro (dipisahkan koma, tanpa trailing slash).
CORS_ALLOWED_ORIGINS=https://admin.lembahkopi.id,https://lembahkopi.id,https://www.lembahkopi.id

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE S3 / MINIO (core-system)
# ------------------------------------------------------------------------------
# Kompatibel dengan MinIO self-hosted, AWS S3, Cloudflare R2, atau Backblaze B2.
# Endpoint internal backend ke storage:
MINIO_ENDPOINT=minio_internal_host:9000
MINIO_ACCESS_KEY=CHANGE_ME_STORAGE_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_STORAGE_SECRET_KEY
MINIO_BUCKET=lembah-kopi-prod
MINIO_USE_SSL=true

# URL Publik yang dibuka browser pengunjung untuk menampilkan foto media/produk/galeri:
# Contoh jika memakai CDN/subdomain publik: https://cdn.lembahkopi.id atau https://pub-xxx.r2.dev
MINIO_PUBLIC_URL=https://cdn.lembahkopi.id

# ------------------------------------------------------------------------------
# 5. WEB DASHBOARD ADMIN (web-dashboard)
# ------------------------------------------------------------------------------
# URL API publik (diakses dari browser admin):
NEXT_PUBLIC_API_BASE_URL=https://api.lembahkopi.id/api/v1
# URL API internal (diakses dari Next.js server-side / container network):
API_BASE_URL=http://core-system:8080/api/v1

# ------------------------------------------------------------------------------
# 6. WEB COMMUNITY PROFILE (web-compro)
# ------------------------------------------------------------------------------
# URL API internal backend (Server Component fetch):
CORE_SYSTEM_API_URL=http://core-system:8080/api/v1
# URL API publik browser:
NEXT_PUBLIC_API_URL=https://api.lembahkopi.id/api/v1
